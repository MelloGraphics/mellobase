{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mellobase/ldtr-events",
  "version": "0.1.0",
  "title": "LDTR Events",
  "category": "widgets",
  "icon": "smiley",
  "description": "Pull in a list of events from TidyHQ.",
  "supports": {
    "html": false
  },
  "attributes": {
    "keywords": {
      "type": "string",
      "default": ""
    },
    "limit": {
      "type": "number",
      "default": 6
    },
    "showAll": {
      "type": "boolean",
      "default": true
    },
    "viewType": {
      "type": "string",
      "default": "grid"
    },
    "slidesOnly": {
      "type": "boolean",
      "default": false
    },
    "showImages": {
      "type": "boolean",
      "default": true
    },
    "showDescription": {
      "type": "boolean",
      "default": false
    },
    "showPast": {
      "type": "boolean",
      "default": false
    },
    "showViewMoreButton": {
      "type": "boolean",
      "default": true
    },
    "showRegisterButton": {
      "type": "boolean",
      "default": true
    }
  },
  "textdomain": "ldtr-events",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}